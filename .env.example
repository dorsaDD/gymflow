# Copy this file to .env. The default runs a model locally through Ollama and
# does not require a paid API key. Never commit .env or share its contents.
GYMFLOW_LLM_PROVIDER=ollama
GYMFLOW_OLLAMA_MODEL=qwen2.5:3b
GYMFLOW_LLM_BASE_URL=http://localhost:11434/v1

# Optional paid cloud provider (only if you explicitly switch providers):
# GYMFLOW_LLM_PROVIDER=openai
# GYMFLOW_LLM_MODEL=gpt-6-luna
# OPENAI_API_KEY=

# Optional local-development settings:
# GYMFLOW_SECRET_KEY=replace-with-a-long-random-secret
# GYMFLOW_TIMEZONE=Europe/Rome
